# API
# MONGO_URL: leave unset to use the built-in database (nothing to install).
# Set it only to use your own MongoDB, e.g. Docker, a server install or MongoDB Atlas:
# MONGO_URL=mongodb://127.0.0.1:27017/hydro_one_demo
API_PORT=3000
JWT_SECRET=change-me-demo-only
DEMO_CUSTOMER_FIRST_NAME=Manny
DEMO_ENROLLED_CUSTOMER_FIRST_NAME=Priya
EV_ALWAYS_CHARGING=true
DEMO_TIMEZONE=America/Toronto
# Web (Vite) reads VITE_* vars
VITE_API_URL=http://localhost:3000
VITE_MOBILE_WEB_URL=http://localhost:8081
# Mobile (Expo) reads EXPO_PUBLIC_* vars. On a real phone set this to your laptop's LAN IP, e.g. http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
